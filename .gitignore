# Python caches and local environments
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Editor-local settings
.vscode/

# Generated outputs are local by default.  Keep only the small, representative
# files explicitly allowed below.
outputs/*

!outputs/figures/
outputs/figures/*
!outputs/figures/A_Rectangular.png
!outputs/figures/B_Hexagonal.png
!outputs/figures/comparison_E_Sector_4x6.png
!outputs/figures/variable_n/
outputs/figures/variable_n/*
!outputs/figures/variable_n/pareto_tradeoffs.png

!outputs/coordinates/
outputs/coordinates/*
!outputs/coordinates/A_Rectangular_coordinates.csv
!outputs/coordinates/B_Hexagonal_coordinates.csv
!outputs/coordinates/comparison_E_Sector_4x6_coordinates.csv

!outputs/summaries/
outputs/summaries/*
!outputs/summaries/baseline_layout_summary.csv
!outputs/summaries/layout_summary.csv
!outputs/summaries/layout_comparison.csv
!outputs/summaries/variable_n_results.csv
!outputs/summaries/pareto_candidates.csv
